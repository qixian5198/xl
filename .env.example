# 复制本文件为 .env 并填入你自己的 NVIDIA NIM key（不要把 .env 提交到 git）
# cp .env.example .env
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# 你的 NVIDIA NIM key，形如 nvapi-xxxx（在 https://build.nvidia.com 获取）
NVIDIA_API_KEY=把你的-nvapi-key-填到这里
# 可用的 NIM 模型 ID（可在界面「设置 → 模型」里点「刷新列表」查看你可用的）
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
LLM_TIMEOUT=60
LLM_RETRIES=1
FEEDBACK_EVERY_N=1
COACH_EVERY_N=5
# 数据库文件路径，默认项目根目录下的 xl.db
# DB_PATH=xl.db
